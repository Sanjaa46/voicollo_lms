# Application
APP_ENV=development
APP_VERSION=1.0.0

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Allowed GitHub username (only this user can log in)
ALLOWED_GITHUB_USERNAME=<github_username>

# JWT signing secret — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_64_char_hex_string

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=mysql+aiomysql://lms_app:<password>@localhost:3306/lms
LMS_APP_DB_PASSWORD=<password>
ROOT_DATABASE_URL=mysql+aiomysql://root:<password>@localhost:3306/lms
RETENTION_DATABASE_URL=mysql+aiomysql://lms_retention:<password>@localhost:3306/lms
LMS_RETENTION_DB_PASSWORD=<password>

# Redis
REDIS_URL=redis://:<password>@localhost:6379/0

# Cache TTLs (seconds)
QUERY_CACHE_TTL_SECONDS=60
HEALTH_CACHE_TTL_SECONDS=10

# Rate limiting
RATE_LIMIT_MAX=1000

# Retention
APP_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
RETENTION_JOB_HOUR=2
RETENTION_JOB_MINUTE=0

FRONTEND_URL=http://localhost:5173