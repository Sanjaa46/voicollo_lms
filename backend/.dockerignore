# Ignore git metadata
.git
.gitignore

# Ignore local virtual environments
backend/venv/
venv/
env/

# Ignore python caches and compilation files
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Ignore test suites and test cache to keep production image clean
backend/tests/
.pytest_cache/
.coverage
htmlcov/

# Ignore local environment configurations and secrets
.env
.env.*
*.secrets

# Ignore IDE settings
.vscode/
.idea/

# Ignore OS-specific files
.DS_Store
Thumbs.db