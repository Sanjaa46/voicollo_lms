# =============================================================================
# Voicollo LMS — deployment configuration.  Copy to `.env` next to
# docker-compose.yml and fill in every value marked REQUIRED.
# Generate secrets with:   openssl rand -hex 32
# =============================================================================

# ---------------------------------------------------------------- release
# REQUIRED. The image tag to run (see CHANGELOG.md). Changing it + `docker
# compose pull && docker compose up -d` is the whole upgrade.
LMS_VERSION=2.0.0
# LMS_IMAGE=ghcr.io/sanjaa46/voicollo-lms

# ---------------------------------------------------------------- web
# REQUIRED. The URL you open in the browser (no trailing slash). Used for the
# GitHub OAuth callback (<PUBLIC_URL>/auth/callback) and CORS.
PUBLIC_URL=https://lms.example.com
APP_ENV=production
# Host port the app listens on. Keep 127.0.0.1 behind a reverse proxy / tunnel;
# use 0.0.0.0 to expose it directly.
LMS_BIND_ADDRESS=127.0.0.1
LMS_HTTP_PORT=8000
# Uvicorn worker processes.
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

# ---------------------------------------------------------------- GitHub sign-in
# REQUIRED. OAuth app: https://github.com/settings/developers
#   Authorization callback URL = <PUBLIC_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# REQUIRED. The only GitHub account allowed to sign in.
ALLOWED_GITHUB_USERNAME=
# Optional but recommended: numeric id (https://api.github.com/users/<name>),
# so a renamed/re-registered username cannot take over the console.
# ALLOWED_GITHUB_USER_ID=

# REQUIRED. >= 32 characters. Changing it signs everyone out.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------- ingestion
# REQUIRED. Shared HMAC secret your services use to sign log requests
# (LMS_INGEST_SECRET in the client packages). >= 16 characters.
INGEST_SIGNING_SECRET=
# Max entries per service per minute.
RATE_LIMIT_MAX=1000
SIGNATURE_TOLERANCE_SECONDS=60

# ---------------------------------------------------------------- database
# REQUIRED. Three distinct passwords. The migrate step creates/updates the
# lms_app and lms_retention users from these on every deploy.
DB_ROOT_PASSWORD=
DB_APP_PASSWORD=
DB_RETENTION_PASSWORD=
DB_NAME=lms
# Upgrading from v1? Point at the existing volume (see `docker volume ls`):
# LMS_DB_VOLUME=voicollo_lms_lms_db_data
# v1 stored ingested_at in UTC+8; migration 0004 shifts it once. Set 0 if your
# v1 database already ran in UTC.
# LMS_LEGACY_TZ_OFFSET_HOURS=8

# ---------------------------------------------------------------- redis
# REQUIRED.
REDIS_PASSWORD=

# ---------------------------------------------------------------- retention
RETENTION_ENABLED=true
APP_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
RETENTION_JOB_HOUR=2
RETENTION_JOB_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Ulaanbaatar

# ---------------------------------------------------------------- tunnel (optional)
# Used by `docker compose --profile tunnel up -d`. Point the tunnel's public
# hostname at http://lms-app:8000.
# CLOUDFLARE_TUNNEL_TOKEN=
