# Application
APP_ENV=production
APP_VERSION=1.0.0

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=client_id
GITHUB_CLIENT_SECRET=client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# Allowed GitHub username (only this user can log in)
ALLOWED_GITHUB_USERNAME=sanjmyat4v

# JWT signing secret — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_64_char_hex_string

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# HMAC Signature secret
INGEST_SIGNING_SECRET=hmac_secret

# Database
DATABASE_URL=mysql+aiomysql://lms_app:password@localhost:3306/lms
DB_HOST=localhost
LMS_APP_DB_PASSWORD=password
ROOT_DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/lms
MARIADB_ROOT_PASSWORD=password
DB_ROOT_PASSWORD=password
RETENTION_DATABASE_URL=mysql+aiomysql://lms_retention:password@localhost:3306/lms
LMS_RETENTION_DB_PASSWORD=password

# Redis
REDIS_URL=redis://:password@localhost:6379/0
REDIS_PASSWORD=password

# Cache TTLs (seconds)
QUERY_CACHE_TTL_SECONDS=60
HEALTH_CACHE_TTL_SECONDS=10

# Rate limiting
RATE_LIMIT_MAX=1000

# Retention
APP_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
RETENTION_JOB_HOUR=2
RETENTION_JOB_MINUTE=0


# Timezone
TZ=Asia/Ulaanbaatar

VITE_API_BASE_URL=http://lms-api:8000/api/v1
LMS_FRONTEND_PORT=5173

FRONTEND_URL=http://localhost:5173

# Cloudflare Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=cloudflare_tunnel_token